# Brine-owned plan=sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb
# IndexDigest=sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
# PlatformManifestDigest=sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
# Platform=linux/arm64

[Unit]
Description=Brine app hello

[Container]
Image=registry.example.com/team/web@sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc
PublishPort=127.0.0.1:20000:3000
PidsLimit=64
PodmanArgs=--memory=256m
LogDriver=k8s-file
LogOpt=max-size=10485760
Secret=brine.hello.token.v1,type=env,target=TOKEN
Environment="A=quote\" slash\\ %%n $$HOME café"
Environment="Z=line one\nline two"

[Service]
Restart=on-failure
SuccessExitStatus=143
RestartForceExitStatus=143

[Install]
WantedBy=default.target
